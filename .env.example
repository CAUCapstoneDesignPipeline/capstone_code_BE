# 로컬 개발 전용. 이 파일을 .env로 복사한 뒤 값을 설정하세요.
# bash/zsh의 source로 읽으므로 공백·특수문자가 있는 값은 작은따옴표로 감싸세요.
POSTGRES_DB=capstone
POSTGRES_USER=capstone
# 반드시 교체할 예시 비밀번호입니다. 안전한 기본값이 아닙니다.
POSTGRES_PASSWORD='replace-with-your-own-local-password'
# 컨테이너의 5432를 연결할 호스트 포트. 충돌 시 이 값 하나만 수정하세요.
POSTGRES_HOST_PORT=5432

# CORS에 허용할 앱 Origin 하나. 경로·끝의 / 없이 지정하세요.
CAPSTONE_APP_URL=http://localhost:5173
# HS256 서명 키. 32 UTF-8 바이트 이상의 무작위 값을 직접 주입하세요.
# 기본 키는 없습니다. 개발용 키와 운영 키는 반드시 분리하세요.
CAPSTONE_JWT_SECRET=''

# Only local/test profiles may enable development login.
CAPSTONE_DEV_TOKEN_ENABLED=false

CAPSTONE_GOOGLE_ENABLED=false
CAPSTONE_GOOGLE_CLIENT_ID=
CAPSTONE_GOOGLE_CLIENT_SECRET=
CAPSTONE_GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth2/google/callback
CAPSTONE_ALLOWED_EMAILS=

# AI-off review implementation only; true is rejected until activation is implemented and approved.
CAPSTONE_AI_ENABLED=false
