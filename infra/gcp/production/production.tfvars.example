project_id                = "capsnote"
project_number            = "169516793433"
zone                      = "asia-northeast3-a"
app_machine_type          = "e2-standard-2"
ai_machine_type           = "e2-highmem-2"
db_tier                   = "db-custom-1-3840"
db_availability_type      = "ZONAL"
db_disk_size_gb           = 50
github_federation_enabled = false
